{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "Machine-readable contract for the story, shot prompts, narration, subtitles, and music cues.",
  "type": "object",
  "required": [
    "title",
    "language",
    "audience",
    "intent",
    "target_duration_seconds",
    "aspect_ratios",
    "style_block",
    "character",
    "shots",
    "music_cues",
    "production_notes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "am"
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 90
    },
    "aspect_ratios": {
      "type": "array",
      "items": {
        "enum": [
          "9:16",
          "16:9"
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "style_block": {
      "type": "string",
      "minLength": 1
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "description",
        "reference_image",
        "reference_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reference_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_seconds",
          "narration_am",
          "subtitle_en",
          "image_prompt",
          "motion_prompt",
          "reference_images",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot-[0-9]{2}$"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "narration_am": {
            "type": "string",
            "minLength": 0
          },
          "subtitle_en": {
            "type": "string"
          },
          "image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 1
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "music_cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start_shot",
          "end_shot",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_shot": {
            "type": "string",
            "pattern": "^shot-[0-9]{2}$"
          },
          "end_shot": {
            "type": "string",
            "pattern": "^shot-[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "production_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
